# Скопируйте в .env или запустите ./scripts/gen-env.sh
APP_ENV=prod
POSTGRES_PASSWORD=change-me
# >= 32 символов
SECRET_KEY=change-me-change-me-change-me-change-me
# base64 32 байта; ротация: "v2:<новый>,v1:<старый>" (первый — активный)
PHONE_ENC_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
# Ключ HMAC для поиска по телефону. Менять нельзя без перехеширования базы
PHONE_HASH_KEY=change-me
# true, когда приложение работает по HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080

# ---- WhatsApp Business Cloud API ----
# Песочница: http://wa-mock:9000 (запуск с --profile sandbox). Боевой режим: https://graph.facebook.com
WA_API_BASE=http://wa-mock:9000
WA_API_VERSION=v23.0
# WhatsApp Manager → API Setup
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Постоянный токен системного пользователя (whatsapp_business_messaging, whatsapp_business_management)
WA_ACCESS_TOKEN=
# Настройки приложения → Основное → Секрет приложения (проверка подписи webhook)
WA_APP_SECRET=
# Любая строка; та же указывается в кабинете Meta при подключении webhook
WA_VERIFY_TOKEN=
# Номер отправителя, только для отображения в интерфейсе (+7 7xx xxx xx xx)
WA_DISPLAY_PHONE=
